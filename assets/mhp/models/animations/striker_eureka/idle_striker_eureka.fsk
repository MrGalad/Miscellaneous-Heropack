{idle_time}={data}

{idle} = sin(pi{data})(1 - {limbSwingAmount})

{h_posY}+=1.25{idle}
{h_posZ}+=-1.5{idle}

{b_posY}+=1.25{idle}
{b_posZ}+=-1.5{idle}

{rarm_rotZ}+=-5'{idle}
{rarm_posY}+=1.25{idle}
{rarm_posZ}+=-1.25{idle}

{rightLowerArm_rotX}+=-12.5'{idle}

{larm_rotZ}+=5'{idle}
{larm_posY}+=1.25{idle}
{larm_posZ}+=-1.25{idle}

{leftLowerArm_rotX}+=-12.5'{idle}

{upperRightLeg_posY}+=1.25{idle}
{upperRightLeg_posZ}+=-1.5{idle}

{lowerRightLeg_rotX}+=7.5'{idle}
{lowerRightLeg_posY}+=1.25{idle}
{lowerRightLeg_posZ}+=-1.5{idle}

{upperLeftLeg_posY}+=1.25{idle}
{upperLeftLeg_posZ}+=-1.5{idle}

{lowerLeftLeg_rotX}+=7.5'{idle}
{lowerLeftLeg_posY}+=1.25{idle}
{lowerLeftLeg_posZ}+=-1.5{idle}