{data} = sin(pi(1 - {data}))^2
{data} = curve {data}

{head_rotX} @ {data} -> 0'
{head_rotY} @ {data} -> 0'
{head_rotZ} @ {data} -> 15'

{head_posX} @ {data} -> 0
{head_posY} @ {data} -> 7
{head_posZ} @ {data} -> 0

{body_rotX} @ {data} -> -50'
{body_rotY} @ {data} -> -20'
{body_rotZ} @ {data} -> 20'

{body_posX} @ {data} -> 0
{body_posY} @ {data} -> 7
{body_posZ} @ {data} -> 0

{leftArm_rotX} @ {data} -> 30'
{leftArm_rotY} @ {data} -> -20'
{leftArm_rotZ} @ {data} -> -15'

{leftArm_posX} @ {data} -> 5
{leftArm_posY} @ {data} -> 11
{leftArm_posZ} @ {data} -> 0

{rightArm_rotX} @ {data} -> -85'
{rightArm_rotY} @ {data} -> 0'
{rightArm_rotZ} @ {data} -> -20'

{rightArm_posX} @ {data} -> -4
{rightArm_posY} @ {data} -> 7
{rightArm_posZ} @ {data} -> -5

{leftLeg_rotX} @ {data} -> -30'
{leftLeg_rotY} @ {data} -> 0'
{leftLeg_rotZ} @ {data} -> 0'

{leftLeg_posX} @ {data} -> 3
{leftLeg_posY} @ {data} -> 9
{leftLeg_posZ} @ {data} -> -7

{rightLeg_rotX} @ {data} -> -65'
{rightLeg_rotY} @ {data} -> 0'
{rightLeg_rotZ} @ {data} -> 0'

{rightLeg_posX} @ {data} -> -1.5
{rightLeg_posY} @ {data} -> 14
{rightLeg_posZ} @ {data} -> -9

out "translate" (0, -0.225{data}, 0)