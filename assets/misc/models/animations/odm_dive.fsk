{data} = curve {data}

{head_rotX} += -5'{data}
{head_rotY} += 0'{data}
{head_rotZ} += 0'{data}
{head_posX} @ {data} -> 0
{head_posY} @ {data} -> 4
{head_posZ} @ {data} -> -4

{body_rotX} @ {data} -> 35'
{body_rotY} @ {data} -> 0'
{body_rotZ} @ {data} -> 0
{body_posX} @ {data} -> 0
{body_posY} @ {data} -> 4
{body_posZ} @ {data} -> -4

{rightArm_rotX} @ {data} -> -2'
{rightArm_rotY} @ {data} -> 10'
{rightArm_rotZ} @ {data} -> 40'  

{rightArm_posX} @ {data} -> -6
{rightArm_posY} @ {data} -> 7   
{rightArm_posZ} @ {data} -> -3

{leftArm_rotX} @ {data} -> -2'
{leftArm_rotY} @ {data} -> -10'
{leftArm_rotZ} @ {data} -> -40'  

{leftArm_posX} @ {data} -> 6
{leftArm_posY} @ {data} -> 7   
{leftArm_posZ} @ {data} -> -3

{d} = sin(pi{data})

{rightLeg_rotX} @ {data} -> 60'   
{rightLeg_rotY} @ {data} -> 0'
{rightLeg_rotZ} @ {data} -> 5'

{rightLeg_posX} @ {data} -> -3
{rightLeg_posY} @ {data} -> 14  
{rightLeg_posZ} @ {data} -> -2

{leftLeg_rotX} @ {data} -> 60'   
{leftLeg_rotY} @ {data} -> -10'
{leftLeg_rotZ} @ {data} -> -5'

{leftLeg_posX} @ {data} -> 3
{leftLeg_posY} @ {data} -> 14 
{leftLeg_posZ} @ {data} -> -2

out "pivot" (0, 0.56, 0)
out "translate" (0, -0.2{data}, 0.0{data})
out "rotate" (-5'{data}, 1, 0, 0)
