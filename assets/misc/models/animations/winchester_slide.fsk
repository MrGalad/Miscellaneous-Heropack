{winchester_flip_time}={data}
{winchester_flip_0}=curve animate2({winchester_flip_time},0.6,0,0.3,0.3)
{winchester_flip_1}=curve animate2({winchester_flip_time},9.7,0.3,0.3,9.4)
{winchester_flip_2}=curve animate2({winchester_flip_time},0.6,0,0.1,0.5)
{winchester_flip_3}=curve animate2({winchester_flip_time},0.6,0.1,0.5,0.1)
{winchester_flip_4}=curve animate2({winchester_flip_time},0.5,0.1,0.2,0.3)
{winchester_flip_5}=curve animate2({winchester_flip_time},0.5,0.3,0.3,0.2)

;{bone_rotX}+=-205'{winchester_flip_0}
{bone_rotX}+=-360'{winchester_flip_1}
