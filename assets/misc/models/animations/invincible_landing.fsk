{data} = curve {data}

{head_rotX} @ {data} -> -69'
{head_rotY} @ {data} -'> -30'
{head_rotZ} @ {data} -> 10'
{head_posX} @ {data} -> 0
{head_posY} @ {data} -> 0
{head_posZ} @ {data} -> 4

{body_rotX} @ {data} -> -30'
{body_rotY} @ {data} -'> -30'
{body_rotZ} @ {data} -> 10'
{body_posX} @ {data} -> 0
{body_posY} @ {data} -> 0
{body_posZ} @ {data} -> 4

{rightArm_rotX} @ {data} -> 15'
{rightArm_rotY} @ {data} -'> -30'
{rightArm_rotZ} @ {data} -> 20'
{rightArm_posX} @ {data} -> -5
{rightArm_posY} @ {data} -> 2
{rightArm_posZ} @ {data} -> 0.5

{leftArm_rotX} @ {data} -> 60'
{leftArm_rotY} @ {data} -'> -60'
{leftArm_rotZ} @ {data} -> -40'
{leftArm_posX} @ {data} -> 6
{leftArm_posY} @ {data} -> 2
{leftArm_posZ} @ {data} -> 5

{d} = sin(pi{data})
{rightLeg_rotX} @ {data} -> -60'
{rightLeg_rotY} @ {data} -'> -20'
{rightLeg_rotZ} @ {data} -> -10'
{rightLeg_posX} @ {data} -> -1
{rightLeg_posY} @ {data} -> 2
{rightLeg_posZ} @ {data} -> -0.5
{rightLeg_rotX} += 40'{d}
{rightLeg_posY} -= 2{d}
{rightLeg_posZ} -= 4{d}
{leftLeg_rotX} @ {data} -> -7'
{leftLeg_rotY} @ {data} -'> -30'
{leftLeg_rotZ} @ {data} -> 0
{leftLeg_posX} @ {data} -> 6
{leftLeg_posY} @ {data} -> 3
{leftLeg_posZ} @ {data} -> -3
{leftLeg_rotX} += 25'{d}
{leftLeg_posZ} -= 2{d}

out "pivot" (0, 0.56, 0)
out "translate" (0, -0.35{data}, 0.25{data})
out "rotate" (25{data}, 0, 0, 1)
out "rotate" (-20{data}, 0, 1, 0)
out "rotate" (-75{data}, 1, 0, 0)
