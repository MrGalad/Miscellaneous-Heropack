{data_0} = curve {data_0}
{data_1} = curve {data_1}

{rightArm_rotX} @ {data_0} -> 0
{rightArm_rotX} += -180'{data_0}


{rightArm_rotX} @ {data_1} -> {head_rotX} - pi / 2
{rightArm_rotY} @ {data_1} -'> {head_rotY}
{rightArm_rotZ} @ {data_1} -> {head_rotZ}

