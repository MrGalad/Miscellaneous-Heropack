{
  "name": "Titan Shift",
  "modifiers": {
    "fiskheroes:transformation": {
      "key": "TITAN",
      "transformation": {
        "toggleData": "misc:dyn/boolean",
        "timerData": "misc:dyn/float_interp",
        "time": 50
      },
      "soundEvents": {
        "ENABLE": "misc:titan_transformation"
      }
    },
    "fiskheroes:transformation|release": {
      "key": "RELEASE",
      "transformation": {
        "toggleData": "misc:dyn/release",
        "timerData": "misc:dyn/release_timer",
        "time": 30
      }
    },
    "fiskheroes:transformation|harden": {
      "key": "HARDEN",
      "transformation": {
        "toggleData": "misc:dyn/hardened",
        "timerData": "misc:dyn/hardened_timer",
        "time": 30
      },
      "soundEvents": {
        "ENABLE": "misc:harden"
      }
    },
    "fiskheroes:transformation|anim": {
      "transformation": {
        "toggleData": "misc:dyn/boolean1",
        "timerData": "misc:dyn/float_interp2",
        "time": 110
      }
    },
    "fiskheroes:transformation|regen": {
      "key": "REGEN",
      "transformation": {
        "toggleData": "misc:dyn/regen",
        "timerData": "misc:dyn/regen_timer",
        "time": 30
      }
    },
    "fiskheroes:size_manipulation|giant": {
      "isInstant": true,
      "minSize": 1.0,
      "maxSize": 8.0
    },
    "fiskheroes:cooldown|eyemarks": {
      "cooldown": {
        "toggleData": "!entity.getData('misc:dyn/boolean') && entity.getData('misc:dyn/eyemarks')",
        "cooldownData": "misc:dyn/charge_timer",
        "duration": 100,
        "recovery": 0.1
      }
    },
    "fiskheroes:healing_factor": {
      "delay": 200,
      "soundEvents": {
        "HEAL": "fiskheroes:healing_factor"
      }
    },
    "fiskheroes:cooldown": {
      "cooldown": {
        "toggleData": "misc:dyn/boolean1",
        "cooldownData": "misc:dyn/titan_cooldown_timer",
        "duration": 2500,
        "recovery": 1
      }
    },
    "fiskheroes:hover": {
      "isToggle": false
    },
     "fiskheroes:shield": {
      "shield": {
        "health": 100000.0,
        "regeneration": 15.0,
        "recoveryDelay": 100,
        "cooldown": 0
      },
      "coverage": {
        "yawRadius": 180.0,
        "pitchRadius": 180.0,
        "yawOffset": 0.0,
        "pitchOffset": 0.0
      },
      "knockback": 0.0,
      "isToggle": false,
      "soundEvents": {
      }
    }
  },  
  "hud": [
    {
      "type": "CHARGE",
      "texture": "misc:textures/gui/bars/titan_charge.png",
      "data": "1 - entity.getData('misc:dyn/titan_cooldown_timer')"
    }
  ]
}